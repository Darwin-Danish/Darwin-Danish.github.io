---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import PageHead from '@/components/PageHead.astro'
import { SITE } from '@/consts'
import Layout from '@/layouts/Layout.astro'
import { Content } from '../content/about.mdx'

const aboutSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: `About - ${SITE.title}`,
  description: SITE.description,
  url: `${SITE.href}/about/`,
  mainEntity: {
    '@type': 'Person',
    '@id': `${SITE.href}#person`,
    name: 'Darwin Danish',
  },
}
---

<Layout>
  <Fragment slot="head">
    <PageHead title="About" />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(aboutSchema)}
    />
  </Fragment>
  <div class="mx-auto w-full max-w-[calc(var(--container-3xl)-2rem)]">
    <Breadcrumbs items={[{ label: 'About', icon: 'lucide:info' }]} />
  </div>

  <section class="flex flex-col gap-4">
    <div class="mx-auto max-w-[calc(var(--container-3xl)-2rem)]">
      <article class="prose">
        <Content />
      </article>
    </div>
  </section>
</Layout>

<style is:global>
  @keyframes moveTreesSlow {
    0% {
      transform: translateX(-50%);
    }
    100% {
      transform: translateX(0);
    }
  }

  @keyframes moveTreesMedium {
    0% {
      transform: translateX(-50%);
    }
    100% {
      transform: translateX(0);
    }
  }

  @keyframes moveTreesFast {
    0% {
      transform: translateX(-50%);
    }
    100% {
      transform: translateX(0);
    }
  }

  @keyframes carSpeedVariation {
    0% {
      transform: translateX(0) scale(1);
    }
    10% {
      transform: translateX(2px) scale(1.05);
    }
    20% {
      transform: translateX(0) scale(1);
    }
    30% {
      transform: translateX(-1px) scale(0.98);
    }
    40% {
      transform: translateX(0) scale(1);
    }
    50% {
      transform: translateX(3px) scale(1.08);
    }
    60% {
      transform: translateX(0) scale(1);
    }
    70% {
      transform: translateX(-2px) scale(0.95);
    }
    80% {
      transform: translateX(0) scale(1);
    }
    90% {
      transform: translateX(1px) scale(1.02);
    }
    100% {
      transform: translateX(0) scale(1);
    }
  }

  @keyframes randomClouds {
    0%,
    100% {
      opacity: 0;
      transform: translateX(0) translateY(0);
    }
    10% {
      opacity: 0.2;
      transform: translateX(10px) translateY(-5px);
    }
    20% {
      opacity: 0.15;
      transform: translateX(-5px) translateY(3px);
    }
    30% {
      opacity: 0.25;
      transform: translateX(8px) translateY(-2px);
    }
    40% {
      opacity: 0.1;
      transform: translateX(-8px) translateY(4px);
    }
    50% {
      opacity: 0.2;
      transform: translateX(5px) translateY(-3px);
    }
    60% {
      opacity: 0.15;
      transform: translateX(-3px) translateY(2px);
    }
    70% {
      opacity: 0.25;
      transform: translateX(7px) translateY(-4px);
    }
    80% {
      opacity: 0.1;
      transform: translateX(-7px) translateY(3px);
    }
    90% {
      opacity: 0.2;
      transform: translateX(4px) translateY(-2px);
    }
  }

  @keyframes digit1Change {
    0% {
      transform: translateY(0);
    }
    6.25% {
      transform: translateY(-1rem);
    }
    12.5% {
      transform: translateY(-2rem);
    }
    18.75% {
      transform: translateY(-3rem);
    }
    25% {
      transform: translateY(-4rem);
    }
    31.25% {
      transform: translateY(-5rem);
    }
    37.5% {
      transform: translateY(-6rem);
    }
    43.75% {
      transform: translateY(-7rem);
    }
    50% {
      transform: translateY(-8rem);
    }
    56.25% {
      transform: translateY(-9rem);
    }
    62.5% {
      transform: translateY(-10rem);
    }
    68.75% {
      transform: translateY(-11rem);
    }
    75% {
      transform: translateY(-12rem);
    }
    81.25% {
      transform: translateY(-13rem);
    }
    87.5% {
      transform: translateY(-14rem);
    }
    93.75% {
      transform: translateY(-15rem);
    }
    100% {
      transform: translateY(0);
    }
  }

  @keyframes digit2Change {
    0% {
      transform: translateY(0);
    }
    60% {
      transform: translateY(0);
    }
    70% {
      transform: translateY(-1rem);
    }
    100% {
      transform: translateY(-1rem);
    }
  }

  @keyframes digit3Change {
    0% {
      transform: translateY(0);
    }
    5% {
      transform: translateY(0);
    }
    10% {
      transform: translateY(-1rem);
    }
    15% {
      transform: translateY(-1rem);
    }
    20% {
      transform: translateY(-2rem);
    }
    25% {
      transform: translateY(-2rem);
    }
    30% {
      transform: translateY(-3rem);
    }
    35% {
      transform: translateY(-3rem);
    }
    40% {
      transform: translateY(-4rem);
    }
    45% {
      transform: translateY(-4rem);
    }
    50% {
      transform: translateY(-5rem);
    }
    55% {
      transform: translateY(-5rem);
    }
    60% {
      transform: translateY(-6rem);
    }
    65% {
      transform: translateY(-6rem);
    }
    70% {
      transform: translateY(-7rem);
    }
    75% {
      transform: translateY(-7rem);
    }
    80% {
      transform: translateY(-8rem);
    }
    85% {
      transform: translateY(-8rem);
    }
    90% {
      transform: translateY(-9rem);
    }
    95% {
      transform: translateY(-9rem);
    }
    100% {
      transform: translateY(0);
    }
  }
</style>
