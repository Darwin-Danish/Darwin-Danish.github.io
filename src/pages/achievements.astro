---
import AchievementsTOCHeader from '@/components/achievements/AchievementsTOCHeader.astro'
import AchievementsTOCSidebar from '@/components/achievements/AchievementsTOCSidebar.astro'
import InteractiveTimeline from '@/components/achievements/InteractiveTimeline'
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import PageHead from '@/components/PageHead.astro'
import { SITE } from '@/consts'
import {
  certifications,
  competitions,
  pressArticles,
} from '@/data/achievements'
import Layout from '@/layouts/Layout.astro'
import { Icon } from 'astro-icon/components'

// Dynamic current ISO date for schema freshness while preserving historical competition dates
const currentIsoDate = new Date().toISOString().split('T')[0]

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: `${SITE.href}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Achievements',
      item: `${SITE.href}/achievements/`,
    },
  ],
}

const achievementsSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `Achievements & Honors - ${SITE.title}`,
  description:
    'Official record of competition championships, technical projects, and academic foundations of Darwin Danish.',
  url: `${SITE.href}/achievements/`,
  datePublished: '2024-11-09',
  dateModified: currentIsoDate,
  numberOfItems: competitions.length + certifications.length + 1,
  itemListElement: [
    ...competitions.map((comp, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      item: {
        '@type': 'CreativeWork',
        name: `${comp.title}${comp.projectName ? ` (${comp.projectName})` : ''}`,
        alternateName: comp.projectName,
        description: comp.description,
        award: comp.prize ? `${comp.award} & ${comp.prize}` : comp.award,
        startDate: comp.isoEventDate,
        datePublished: comp.isoEventDate,
        dateModified: currentIsoDate,
        sponsor: {
          '@type': 'Organization',
          name: comp.organizer,
        },
        recipient: {
          '@type': 'Person',
          '@id': `${SITE.href}#person`,
          name: 'Darwin Danish',
        },
        creator: {
          '@type': 'Person',
          '@id': `${SITE.href}#person`,
          name: 'Darwin Danish',
        },
        contributor: comp.team?.map((member) => ({
          '@type': 'Person',
          name: member.name,
          jobTitle: member.role,
        })),
        keywords: comp.technologies,
        locationCreated: comp.location
          ? {
              '@type': 'Place',
              name: comp.location,
            }
          : undefined,
        image:
          comp.images && comp.images.length > 0
            ? comp.images.map((img) => ({
                '@type': 'ImageObject',
                url: img.src.startsWith('http')
                  ? img.src
                  : `${SITE.href}${img.src.startsWith('/') ? img.src : '/' + img.src}`,
                caption: img.caption || img.alt,
                description: img.alt,
                width: img.width ? `${img.width}px` : undefined,
                height: img.height ? `${img.height}px` : undefined,
              }))
            : comp.image
              ? [
                  {
                    '@type': 'ImageObject',
                    url: comp.image.startsWith('http')
                      ? comp.image
                      : `${SITE.href}${comp.image.startsWith('/') ? comp.image : '/' + comp.image}`,
                  },
                ]
              : undefined,
        ...(comp.link
          ? {
              url: comp.link.startsWith('http')
                ? comp.link
                : `${SITE.href}${comp.link.startsWith('/') ? comp.link : '/' + comp.link}`,
            }
          : {}),
      },
    })),
    ...certifications.map((cert, idx) => ({
      '@type': 'ListItem',
      position: competitions.length + idx + 1,
      item: {
        '@type': 'EducationalOccupationalCredential',
        name: cert.name,
        credentialCategory: 'certification',
        recognizedBy: {
          '@type': 'Organization',
          name: cert.issuer,
        },
        dateCreated: cert.isoDate || cert.issueDate,
        dateModified: currentIsoDate,
        ...(cert.verificationUrl ? { url: cert.verificationUrl } : {}),
        recipient: {
          '@type': 'Person',
          '@id': `${SITE.href}#person`,
          name: 'Darwin Danish',
        },
      },
    })),
    {
      '@type': 'ListItem',
      position: competitions.length + certifications.length + 1,
      item: {
        '@type': 'EducationalOccupationalProgram',
        name: 'Secondary Education — Science Stream',
        description:
          'Secondary education at SMK Kapit (Kapit National Secondary School) in Sarawak, pursuing the Science Stream with dedicated coursework in Physics, Chemistry, Biology, and Additional Mathematics alongside self-directed engineering initiatives.',
        provider: {
          '@type': 'EducationalOrganization',
          name: 'SMK Kapit (Kapit National Secondary School)',
          address: {
            '@type': 'PostalAddress',
            addressLocality: 'Kapit',
            addressRegion: 'Sarawak',
            addressCountry: 'MY',
          },
        },
        educationalProgramMode: 'full-time',
        occupationalCategory:
          'Science, Technology, Engineering & Mathematics (STEM)',
        startDate: '2022',
        recipient: {
          '@type': 'Person',
          '@id': `${SITE.href}#person`,
          name: 'Darwin Danish',
        },
      },
    },
  ],
}

const featuredCompetition =
  competitions.find((c) => c.featured) || competitions[0]
const otherCompetitions = competitions.filter(
  (c) => c.id !== featuredCompetition?.id,
)

const featuredImages = [
  ...(featuredCompetition?.images || []),
  ...(featuredCompetition?.image
    ? [
        {
          src: featuredCompetition.image,
          alt: `${featuredCompetition.title} Photo`,
          caption: `${featuredCompetition.title} Evidence`,
          width: 1280,
          height: 960,
        },
      ]
    : []),
]
---

<Layout>
  <Fragment slot="head">
    <PageHead
      title="Achievements"
      description="Official record of competitive championships, technical projects, and academic foundations by Darwin Danish."
      image="/uploads/cc7c7aaf-b7aa-4ded-a0d8-8ceb4e59b01d.jpg"
      keywords={[
        'Achievements',
        'Awards',
        'Mini Inno Waste 2.0',
        'Project Lumina',
        'SMK Kapit',
        'Science Stream',
        'Darwin Danish',
        'Competitions',
      ]}
    />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(achievementsSchema)}
    />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(breadcrumbSchema)}
    />
  </Fragment>

  <!-- Mobile Sticky Table of Contents Header -->
  <AchievementsTOCHeader slot="table-of-contents" />

  <section
    class="grid grid-cols-[minmax(0px,1fr)_min(calc(var(--breakpoint-md)-2rem),100%)_minmax(0px,1fr)] gap-y-6"
  >
    <div class="col-start-2">
      <Breadcrumbs items={[{ label: 'Achievements', icon: 'lucide:trophy' }]} />
    </div>

    <!-- Desktop Sticky Sidebar Table of Contents -->
    <AchievementsTOCSidebar />

    <div class="col-start-2 flex w-full flex-col gap-12 pb-14 text-left">
      <!-- 1. Header with Metadata -->
      <header class="border-border/60 flex flex-col gap-3 border-b pb-8">
        <div class="space-y-2">
          <h1
            class="text-foreground flex items-center gap-3 text-2xl font-bold tracking-tight sm:text-3xl"
          >
            Achievements & Honors
          </h1>
          <p class="text-muted-foreground text-sm leading-relaxed sm:text-base">
            Official record of competitive championships, technical projects,
            and academic foundations rooted in Kapit, Sarawak.
          </p>
        </div>
      </header>

      <!-- 2. Press & Media Coverage -->
      <section id="press-room" class="flex scroll-mt-24 flex-col gap-6">
        <div class="flex flex-col gap-1">
          <div
            class="text-muted-foreground flex items-center gap-2 font-mono text-xs font-semibold tracking-wider uppercase"
          >
            <Icon name="lucide:newspaper" class="text-foreground size-4" />
            <span>In The News</span>
          </div>
          <h2 class="text-foreground text-xl font-bold tracking-tight">
            Journalistic & Media Coverage
          </h2>
        </div>

        {
          pressArticles.length > 0 ? (
            <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
              {pressArticles.map((article) => (
                <article class="border-border bg-muted/15 hover:border-foreground/30 flex flex-col justify-between rounded-lg border p-4 transition-all duration-200 sm:p-5">
                  <div class="space-y-3">
                    <div class="flex flex-wrap items-center justify-between gap-2">
                      <span class="border-border bg-muted/40 text-foreground rounded border px-2 py-0.5 font-mono text-[10px] font-semibold">
                        {article.publisher}
                      </span>
                      <span class="text-muted-foreground font-mono text-[10px]">
                        {article.date}
                      </span>
                    </div>

                    <h3 class="text-foreground text-sm font-semibold tracking-tight sm:text-base">
                      {article.title}
                    </h3>

                    <p class="text-muted-foreground text-xs leading-relaxed">
                      {article.excerpt}
                    </p>
                  </div>

                  <div class="border-border/40 mt-4 flex items-center justify-between border-t pt-3 font-mono text-xs">
                    <span class="text-muted-foreground text-[11px]">
                      {article.readTime}
                    </span>
                    <a
                      href={article.link}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-foreground hover:text-muted-foreground inline-flex items-center gap-1 transition-colors hover:underline"
                    >
                      <span>Read Article</span>
                      <Icon name="lucide:external-link" class="size-3" />
                    </a>
                  </div>
                </article>
              ))}
            </div>
          ) : (
            <div class="border-border/80 bg-muted/10 text-muted-foreground rounded-lg border border-dashed p-8 text-center font-mono text-xs">
              <Icon
                name="lucide:newspaper"
                class="text-muted-foreground/60 mx-auto mb-2.5 size-5"
              />
              <p class="text-foreground text-sm font-semibold">
                Nothing here yet
              </p>
              <p class="text-muted-foreground mt-1 text-[11px]">
                Media coverage and journalistic records are currently being
                compiled and will be updated soon.
              </p>
            </div>
          )
        }
      </section>

      <!-- 3. Featured Competitions & Hackathons -->
      {
        featuredCompetition && (
          <section id="competitions" class="flex scroll-mt-24 flex-col gap-6">
            <div class="flex flex-col gap-1">
              <div class="text-muted-foreground flex items-center gap-2 font-mono text-xs font-semibold tracking-wider uppercase">
                <Icon name="lucide:trophy" class="text-foreground size-4" />
                <span>Competitions & Honors</span>
              </div>
              <h2 class="text-foreground text-xl font-bold tracking-tight">
                Competition History
              </h2>
            </div>

            {/* Featured Champion Highlight Card: Mini Inno Waste 2.0 */}
            <div
              id="featured-champion"
              class="border-border bg-muted/15 scroll-mt-24 rounded-lg border p-5 transition-all duration-200 sm:p-6"
            >
              <div class="border-border/60 mb-4 flex flex-wrap items-center justify-between gap-2 border-b pb-4">
                <div class="border-border bg-muted/40 text-foreground inline-flex items-center gap-2 rounded border px-3 py-1 font-mono text-xs font-semibold">
                  <Icon
                    name="lucide:award"
                    class="text-foreground size-4 shrink-0"
                  />
                  <span>
                    {featuredCompetition.award} • {featuredCompetition.prize}
                  </span>
                </div>
                <div class="text-muted-foreground flex items-center gap-1.5 font-mono text-xs">
                  <Icon name="lucide:calendar" class="size-3.5" />
                  <time datetime={featuredCompetition.isoEventDate}>
                    {featuredCompetition.eventDate}
                  </time>
                </div>
              </div>

              <div class="space-y-4">
                <div>
                  <h3 class="text-foreground text-lg font-bold sm:text-xl">
                    {featuredCompetition.title}
                  </h3>
                  <p class="text-muted-foreground mt-1 font-mono text-xs sm:text-sm">
                    {featuredCompetition.projectSubtitle}
                  </p>
                </div>

                <p class="text-muted-foreground text-xs leading-relaxed sm:text-sm">
                  {featuredCompetition.description}
                </p>

                {/* Team Roster */}
                {featuredCompetition.team && (
                  <div class="border-border bg-background/50 grid grid-cols-1 gap-2.5 rounded-lg border p-3 font-mono text-xs sm:grid-cols-2">
                    {featuredCompetition.team.map((member) => (
                      <div>
                        <span class="text-foreground font-semibold">
                          {member.name}
                        </span>
                        <span class="text-muted-foreground block text-[11px]">
                          {member.role}
                        </span>
                      </div>
                    ))}
                  </div>
                )}

                {/* Real Photo Evidence Gallery */}
                {featuredImages.length > 0 && (
                  <div class="grid grid-cols-1 gap-3 pt-2 sm:grid-cols-2">
                    {featuredImages.map((img, idx) => (
                      <figure class="group/photo border-border bg-muted/20 hover:border-foreground/40 relative m-0 block overflow-hidden rounded-lg border transition-colors">
                        <a
                          href={img.src}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="block overflow-hidden"
                          aria-label={`View full resolution: ${img.alt}`}
                        >
                          <img
                            src={img.src}
                            alt={img.alt}
                            width={img.width || 1280}
                            height={img.height || 960}
                            loading={idx === 0 ? 'eager' : 'lazy'}
                            fetchpriority={idx === 0 ? 'high' : 'auto'}
                            decoding="async"
                            class="h-56 w-full object-cover object-top transition-transform duration-200 group-hover/photo:scale-[1.02] sm:h-64"
                          />
                        </a>
                        <figcaption class="border-border/60 bg-background/90 text-muted-foreground flex items-center justify-between border-t p-2.5 font-mono text-[11px]">
                          <span>{img.caption || 'Award Evidence'}</span>
                          <a
                            href={img.src}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-foreground hover:text-muted-foreground inline-flex items-center transition-colors"
                            aria-label={`Open photo in new tab: ${img.caption || 'Award Evidence'}`}
                          >
                            <Icon
                              name="lucide:external-link"
                              class="size-3 shrink-0"
                            />
                          </a>
                        </figcaption>
                      </figure>
                    ))}
                  </div>
                )}

                {/* Bottom Action & Tech Tags */}
                <div class="border-border/40 flex flex-wrap items-center justify-between gap-3 border-t pt-3">
                  <div class="flex flex-wrap items-center gap-1.5">
                    {featuredCompetition.technologies?.map((tech) => (
                      <span class="border-border bg-background text-muted-foreground rounded border px-2 py-0.5 font-mono text-[10px]">
                        {tech}
                      </span>
                    ))}
                  </div>

                  {featuredCompetition.link && (
                    <a
                      href={featuredCompetition.link}
                      class="border-border bg-muted hover:bg-muted/80 text-foreground inline-flex items-center gap-1.5 rounded border px-3 py-1.5 font-mono text-xs font-medium transition-colors"
                    >
                      <span>
                        {featuredCompetition.linkLabel || 'View Details'}
                      </span>
                      <Icon name="lucide:arrow-right" class="size-3.5" />
                    </a>
                  )}
                </div>
              </div>
            </div>

            {/* Additional Competitions Section */}
            <div id="additional-competitions" class="scroll-mt-24 space-y-3">
              <div class="text-muted-foreground font-mono text-xs font-semibold tracking-wider uppercase">
                Additional Competitions & Challenges
              </div>

              {otherCompetitions.length > 0 ? (
                otherCompetitions.map((comp) => (
                  <div class="border-border bg-muted/15 hover:border-foreground/30 rounded-lg border p-5 font-mono text-xs transition-all duration-200">
                    <div class="border-border/60 mb-3 flex flex-wrap items-center justify-between gap-2 border-b pb-3">
                      <div class="border-border bg-muted/40 text-foreground inline-flex items-center gap-2 rounded border px-2.5 py-1 font-semibold">
                        <Icon
                          name="lucide:award"
                          class="text-foreground size-4 shrink-0"
                        />
                        <span>
                          {comp.award}
                          {comp.prize ? ` • ${comp.prize}` : ''}
                        </span>
                      </div>
                      <div class="text-muted-foreground flex items-center gap-1.5 font-mono text-xs">
                        <Icon name="lucide:calendar" class="size-3.5" />
                        <time datetime={comp.isoEventDate}>
                          {comp.eventDate}
                        </time>
                      </div>
                    </div>
                    <div>
                      <h4 class="text-foreground text-base font-bold tracking-tight">
                        {comp.title}
                      </h4>
                      {comp.projectSubtitle && (
                        <p class="text-muted-foreground mt-0.5 font-mono text-xs">
                          {comp.projectSubtitle}
                        </p>
                      )}
                      <p class="text-muted-foreground mt-2 font-sans text-xs leading-relaxed sm:text-sm">
                        {comp.description}
                      </p>
                      {comp.technologies && comp.technologies.length > 0 && (
                        <div class="mt-3 flex flex-wrap gap-1.5">
                          {comp.technologies.map((tech) => (
                            <span class="border-border bg-background text-muted-foreground rounded border px-2 py-0.5 text-[10px]">
                              {tech}
                            </span>
                          ))}
                        </div>
                      )}
                    </div>
                  </div>
                ))
              ) : (
                <div class="border-border/80 bg-muted/10 text-muted-foreground rounded-lg border border-dashed p-6 text-center font-mono text-xs">
                  <Icon
                    name="lucide:inbox"
                    class="text-muted-foreground/60 mx-auto mb-2 size-5"
                  />
                  <p class="text-foreground font-semibold">Nothing here yet</p>
                  <p class="text-muted-foreground mt-1 text-[11px]">
                    Past competition entries are currently being archived and
                    will be added soon.
                  </p>
                </div>
              )}
            </div>
          </section>
        )
      }

      {/* 4. Certifications Section */}
      <section id="credentials" class="flex scroll-mt-24 flex-col gap-6">
        <div class="flex flex-col gap-1">
          <div
            class="text-muted-foreground flex items-center gap-2 font-mono text-xs font-semibold tracking-wider uppercase"
          >
            <Icon name="lucide:shield-check" class="text-foreground size-4" />
            <span>Certifications</span>
          </div>
          <h2 class="text-foreground text-xl font-bold tracking-tight">
            Technical Credentials
          </h2>
        </div>

        {
          certifications.length > 0 ? (
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              {certifications.map((cred) => (
                <div class="border-border bg-muted/15 rounded-lg border p-4 font-mono text-xs">
                  <div class="text-foreground font-semibold">{cred.name}</div>
                  <div class="text-muted-foreground">{cred.issuer}</div>
                </div>
              ))}
            </div>
          ) : (
            <div class="border-border/80 bg-muted/10 text-muted-foreground rounded-lg border border-dashed p-8 text-center font-mono text-xs">
              <Icon
                name="lucide:award"
                class="text-muted-foreground/60 mx-auto mb-2.5 size-5"
              />
              <p class="text-foreground text-sm font-semibold">
                Nothing here yet
              </p>
              <p class="text-muted-foreground mt-1 text-[11px]">
                Technical certifications and credentials will be uploaded here
                soon.
              </p>
            </div>
          )
        }
      </section>

      <!-- 5. Academic Foundations & Journey -->
      <section id="timeline" class="flex scroll-mt-24 flex-col gap-6">
        <div class="flex flex-col gap-1">
          <div
            class="text-muted-foreground flex items-center gap-2 font-mono text-xs font-semibold tracking-wider uppercase"
          >
            <Icon name="lucide:graduation-cap" class="text-foreground size-4" />
            <span>Academic Foundations</span>
          </div>
          <h2 class="text-foreground text-xl font-bold tracking-tight">
            Academic Background & STEM Focus
          </h2>
          <p class="text-muted-foreground text-xs sm:text-sm">
            Current secondary education at SMK Kapit (Kapit National Secondary
            School) and core scientific disciplines.
          </p>
        </div>

        {/* React Interactive Timeline Component */}
        <InteractiveTimeline client:load />
      </section>
    </div>
  </section>
</Layout>
