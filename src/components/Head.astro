---
import { SITE } from '@/consts'
import SpeedInsights from '@vercel/speed-insights/astro'
import { getEntry } from 'astro:content'
import { ClientRouter } from 'astro:transitions'
import Favicons from './Favicons.astro'

const authorEntry = await getEntry('authors', 'darwindanish')
const author = authorEntry?.data

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${SITE.href}#person`,
  "name": author?.name || "Darwin Danish",
  "legalName": author?.fullName || "Darwin Danish Anak Geramong",
  "alternateName": [
    "Darwin Danish Anak Geramong",
    "Darwin Danish"
  ],
  "givenName": "Darwin Danish",
  "familyName": "Anak Geramong",
  "url": SITE.href,
  "jobTitle": "Student & Computer Engineering Enthusiast",
  "description": author?.bio || SITE.description,
  "image": [
    author?.avatar
      ? (author.avatar.startsWith('http')
          ? author.avatar
          : `${SITE.href}${author.avatar.startsWith('/') ? author.avatar : '/' + author.avatar}`)
      : `${SITE.href}/static/logo.png`,
  ],
  "sameAs": [
    author?.website && author.website !== SITE.href ? author.website : null,
    author?.github,
    author?.linkedin,
    author?.twitter,
    author?.discord,
    author?.discordInvite,
    "https://huggingface.co/DarwinDanish",
    "https://peerlist.io/darwindanish",
    "https://stackoverflow.com/users/22384131/darwin-danish",
  ].filter(Boolean),
  "knowsAbout": [
    "Computer Engineering",
    "IoT",
    "Machine Learning",
    "Robotics",
    "Astronomy",
    "Software Development"
  ]
}
---

<head>
  <meta charset="utf-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0, user-scalable=yes"
  />
  <meta name="generator" content={Astro.generator} />
  <meta name="author" content="Darwin Danish" />

  <meta name="HandheldFriendly" content="True" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <meta
    name="format-detection"
    content="telephone=no,date=no,address=no,email=no,url=no"
  />

  <meta
    name="theme-color"
    content="#e9d3b6"
    media="(prefers-color-scheme: dark)"
  />
  <meta
    name="theme-color"
    content="#e9d3b6"
    media="(prefers-color-scheme: light)"
  />

  <link rel="sitemap" href="/sitemap-index.xml" />
  <link
    rel="alternate"
    type="application/rss+xml"
    title={SITE.title}
    href={new URL('rss.xml', Astro.site)}
  />

  <meta name="keywords" content={SITE.keywords.join(', ')} />
  <meta property="og:site_name" content={SITE.title} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={Astro.url} />

  <Favicons />
  <ClientRouter />
  <SpeedInsights />

  <script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)}>
  </script>
  <slot />
</head>
