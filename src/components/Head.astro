---
import { SITE } from '@/consts'
import SpeedInsights from '@vercel/speed-insights/astro'
import { ClientRouter } from 'astro:transitions'
import Favicons from './Favicons.astro'
---

<head>
  <meta charset="utf-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0, user-scalable=yes"
  />
  <meta name="generator" content={Astro.generator} />

  <meta name="HandheldFriendly" content="True" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <meta
    name="format-detection"
    content="telephone=no,date=no,address=no,email=no,url=no"
  />

  <meta
    name="theme-color"
    content="#e9d3b6"
    media="(prefers-color-scheme: dark)"
  />
  <meta
    name="theme-color"
    content="#e9d3b6"
    media="(prefers-color-scheme: light)"
  />

  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="manifest" href="/site.webmanifest" />
  <link
    rel="alternate"
    type="application/rss+xml"
    title={SITE.title}
    href={new URL('rss.xml', Astro.site)}
  />

  <meta name="keywords" content={SITE.keywords.join(', ')} />
  <meta property="og:site_name" content={SITE.title} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={Astro.url} />

  <Favicons />
  <ClientRouter />
  <SpeedInsights />

  <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Darwin Danish",
      "url": "https://darwindanish.dev",
      "jobTitle": "Student & Developer",
      "description": "Student and developer from Kapit, Sarawak, focused on building innovative solutions in AI, IoT, and Computer Science.",
      "homeLocation": {
        "@type": "Place",
        "name": "Kapit, Sarawak, Malaysia"
      },
      "alumniOf": {
        "@type": "EducationalOrganization",
        "name": "Kapit National Secondary School"
      },
      "knowsAbout": [
        "Computer Science",
        "Machine Learning",
        "Artificial Intelligence",
        "Internet of Things",
        "Engineering",
        "Innovation"
      ],
      "image": [
        "https://darwindanish.dev/images/main-profile.webp",
        "https://darwindanish.dev/images/photo-2.webp",
        "https://darwindanish.dev/images/photo-3.webp",
        "https://darwindanish.dev/images/photo-4.webp"
      ],
      "sameAs": [
        "https://www.facebook.com/share/1HuPb31kuo/",
        "https://linkedin.com/in/darwin-danish",
        "https://github.com/Darwin-Danish",
        "https://huggingface.co/DarwinDanish",
        "https://peerlist.io/darwindanish",
        "https://gitlab.com/darwindanish",
        "https://threads.net/darwin.danish29",
        "https://stackoverflow.com/users/22384131/darwin-danish",
        "https://t.me/darwindanish29"
      ]
    }
  </script>

  <slot />
</head>
