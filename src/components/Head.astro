---
import { SITE } from '@/consts'
import { getEntry } from 'astro:content'
import { ClientRouter } from 'astro:transitions'
import Favicons from './Favicons.astro'

const authorEntry = await getEntry('authors', 'darwindanish')
const author = authorEntry?.data

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${SITE.href}#person`,
  name: author?.name || 'Darwin Danish',
  legalName: author?.fullName || 'Darwin Danish Anak Geramong',
  alternateName: ['Darwin Danish Anak Geramong', 'Darwin Danish'],
  givenName: 'Darwin Danish',
  familyName: 'Anak Geramong',
  gender: 'https://schema.org/Male',
  birthDate: '2009-02-24',
  url: SITE.href,
  jobTitle: 'Student & Computer Engineering Enthusiast',
  description: author?.bio || SITE.description,
  image: [
    author?.avatar
      ? author.avatar.startsWith('http')
        ? author.avatar
        : `${SITE.href}${author.avatar.startsWith('/') ? author.avatar : '/' + author.avatar}`
      : `${SITE.href}/static/logo.png`,
  ],
  homeLocation: {
    '@type': 'Place',
    name: 'Kapit',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Kapit',
      addressRegion: 'Sarawak',
      addressCountry: 'MY',
    },
  },
  nationality: {
    '@type': 'Country',
    name: 'Malaysia',
  },
  alumniOf: {
    '@type': 'EducationalOrganization',
    name: 'Kapit National Secondary School',
    alternateName: 'SMK Kapit',
  },
  award: [
    '1st Place Champion (Juara Pertama) & RM 1,000 Grand Prize - Pertandingan Reka Cipta Mini Inno Waste 2.0 (Project Lumina)',
  ],
  knowsLanguage: [
    {
      '@type': 'Language',
      name: 'Malay',
      alternateName: 'ms',
    },
    {
      '@type': 'Language',
      name: 'English',
      alternateName: 'en',
    },
    {
      '@type': 'Language',
      name: 'German',
      alternateName: 'de',
    },
    {
      '@type': 'Language',
      name: 'Spanish',
      alternateName: 'es',
    },
  ],
  sameAs: [
    author?.website && author.website !== SITE.href ? author.website : null,
    author?.github || 'https://github.com/Darwin-Danish',
    author?.linkedin || 'https://linkedin.com/in/darwin-danish',
    author?.instagram || 'https://www.instagram.com/darwin.danish29',
    author?.threads || 'https://www.threads.net/@darwin.danish29',
    author?.gravatar || 'https://gravatar.com/darwindanish',
    author?.huggingface || 'https://huggingface.co/DarwinDanish',
    author?.pypi || 'https://pypi.org/user/DarwinDanish/',
    author?.stackoverflow ||
      'https://stackoverflow.com/users/22384131/darwin-danish',
    author?.gitlab || 'https://gitlab.com/darwindanish',
    author?.kofi || 'https://ko-fi.com/darwindanish',
    author?.facebook,
    author?.discord,
  ].filter(Boolean),
  knowsAbout: [
    'Computer Science',
    'Computer Engineering',
    'IoT',
    'Internet of Things',
    'Machine Learning',
    'Artificial Intelligence',
    'Robotics',
    'Coding',
    'Software Development',
    'Formula 1',
    'Motorsport Tech & Innovation',
  ],
}
---

<head>
  <meta charset="utf-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0, user-scalable=yes"
  />
  <meta name="generator" content={Astro.generator} />
  <meta name="author" content="Darwin Danish" />

  <meta name="HandheldFriendly" content="True" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <meta
    name="format-detection"
    content="telephone=no,date=no,address=no,email=no,url=no"
  />

  <meta
    name="theme-color"
    content="#e9d3b6"
    media="(prefers-color-scheme: dark)"
  />
  <meta
    name="theme-color"
    content="#e9d3b6"
    media="(prefers-color-scheme: light)"
  />

  <link rel="sitemap" href="/sitemap-index.xml" />
  <link
    rel="alternate"
    type="application/rss+xml"
    title={SITE.title}
    href={new URL('rss.xml', Astro.site)}
  />

  <meta name="keywords" content={SITE.keywords.join(', ')} />

  <Favicons />
  <ClientRouter />

  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(personSchema)}
  />
  <slot />
</head>
