---
import Link from '@/components/Link.astro'
import { buttonVariants } from '@/components/ui/button'
import { ICON_MAP } from '@/consts'
import type { SocialLink } from '@/types'
import { Icon } from 'astro-icon/components'

interface Props {
  links: SocialLink[]
}

const { links } = Astro.props
---

<ul class="flex flex-wrap gap-2" role="list">
  {
    links.map(({ href, label }) => (
      <li>
        <Link
          href={href}
          aria-label={label}
          title={label}
          class={buttonVariants({ variant: 'outline', size: 'icon' })}
          external
        >
          {label === 'Gravatar' ? (
            <img src="/static/icons/gravatar.png" alt="Gravatar Icon" class="size-[1.3rem] gravatar-icon" />
          ) : (
            <Icon
              name={
                ICON_MAP[label as keyof typeof ICON_MAP] ||
                'lucide:message-circle-question'
              }
              class="size-4"
            />
          )}
        </Link>
      </li>
    ))
  }
</ul>

<style>
  .gravatar-icon {
    /* Convert black image to match foreground color */
    /* Make black image white, which will match the foreground color in both light and dark themes */
    filter: brightness(0) saturate(100%) invert(1);
    opacity: 0.9;
    transition: opacity 0.2s;
  }
  
  /* Match the icon color on hover */
  a:hover .gravatar-icon {
    opacity: 1;
  }
</style>
