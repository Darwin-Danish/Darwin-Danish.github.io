---
import Link from '@/components/Link.astro'
import MobileMenu from '@/components/ui/MobileMenu.astro'
import { NAV_LINKS } from '@/consts'
import { Image } from 'astro:assets'
import logo from '../../public/static/logo.png'
---

<header transition:persist>
  <div
    class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-4 py-3"
  >
    <Link href="/" class="flex shrink-0">
      <Image
        src={logo}
        alt="Logo"
        width={48}
        height={48}
        class="size-5 sm:size-6"
      />
    </Link>
    <div class="flex items-center gap-4">
      {/* Desktop Navigation */}
      <nav class="hidden items-center gap-6 text-sm sm:flex">
        {
          NAV_LINKS.map((item) => (
            <Link
              href={item.href}
              class="text-foreground/60 hover:text-foreground/80 capitalize transition-colors"
            >
              {item.label}
            </Link>
          ))
        }
      </nav>

      {/* Mobile Burger Menu */}
      <MobileMenu />
    </div>
  </div>
</header>
