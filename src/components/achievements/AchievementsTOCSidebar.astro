---
import { ScrollArea } from '@/components/ui/scroll-area'
import { Icon } from 'astro-icon/components'

interface TOCItem {
  id: string
  label: string
  sub?: boolean
}

const tocItems: TOCItem[] = [
  { id: 'press-room', label: 'In The News', sub: false },
  { id: 'competitions', label: 'Competitions & Honors', sub: false },
  { id: 'featured-champion', label: 'Mini Inno Waste 2.0', sub: true },
  { id: 'additional-competitions', label: 'Additional Challenges', sub: true },
  { id: 'credentials', label: 'Certifications', sub: false },
  { id: 'timeline', label: 'Academic Foundations', sub: false },
]
---

<aside
  id="achievements-desktop-toc"
  class="sticky top-20 col-start-1 row-span-1 mr-8 ml-auto hidden h-[calc(100vh-5rem)] w-60 max-w-xs select-none xl:block"
  aria-label="Table of contents"
>
  <ScrollArea
    client:load
    className="flex max-h-[calc(100vh-8rem)] flex-col overflow-y-auto"
    type="hover"
  >
    <div class="flex flex-col gap-3 py-2 pr-4 font-mono">
      <div
        class="text-muted-foreground flex items-center gap-1.5 text-xs font-semibold tracking-wider uppercase"
      >
        <Icon name="lucide:list" class="size-3.5" />
        <span>Contents</span>
      </div>

      <nav class="flex flex-col gap-1 text-xs">
        {
          tocItems.map((item) => (
            <a
              href={`#${item.id}`}
              data-toc-target={item.id}
              class={`achievements-desktop-toc-link transition-colors duration-150 ${
                item.sub
                  ? 'border-border/50 text-muted-foreground/75 hover:border-foreground/60 hover:text-foreground ml-2 border-l py-1 pl-3'
                  : 'text-muted-foreground hover:text-foreground py-1 font-medium'
              }`}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </div>
  </ScrollArea>
</aside>

<script>
  class AchievementsDesktopTOCController {
    links: NodeListOf<HTMLAnchorElement> | null = null
    sections: { id: string; top: number }[] = []

    init() {
      this.links = document.querySelectorAll('.achievements-desktop-toc-link')
      if (!this.links || this.links.length === 0) return

      this.cacheSectionPositions()
      window.addEventListener('scroll', this.handleScroll, { passive: true })
      window.addEventListener('resize', this.cacheSectionPositions, {
        passive: true,
      })
      this.handleScroll()
    }

    cacheSectionPositions = () => {
      if (!this.links) return
      this.sections = []

      this.links.forEach((link) => {
        const id = link.getAttribute('data-toc-target')
        if (!id) return
        const element = document.getElementById(id)
        if (element) {
          this.sections.push({
            id,
            top: element.getBoundingClientRect().top + window.scrollY,
          })
        }
      })

      this.sections.sort((a, b) => a.top - b.top)
    }

    handleScroll = () => {
      if (!this.links || this.sections.length === 0) return

      const scrollPos = window.scrollY + 140
      const isAtBottom =
        window.innerHeight + window.scrollY >=
        document.documentElement.scrollHeight - 60

      let activeId = this.sections[0]?.id || ''

      if (isAtBottom) {
        activeId = this.sections[this.sections.length - 1]?.id || ''
      } else {
        for (let i = this.sections.length - 1; i >= 0; i--) {
          if (scrollPos >= this.sections[i].top) {
            activeId = this.sections[i].id
            break
          }
        }
      }

      this.links.forEach((link) => {
        const targetId = link.getAttribute('data-toc-target')
        const isActive = targetId === activeId

        if (isActive) {
          link.classList.remove(
            'text-muted-foreground',
            'text-muted-foreground/75',
          )
          link.classList.add('text-foreground', 'font-semibold')
          if (link.classList.contains('border-l')) {
            link.classList.remove('border-border/50')
            link.classList.add('border-foreground')
          }
        } else {
          link.classList.remove('text-foreground', 'font-semibold')
          link.classList.add(
            link.classList.contains('border-l')
              ? 'text-muted-foreground/75'
              : 'text-muted-foreground',
          )
          if (link.classList.contains('border-l')) {
            link.classList.remove('border-foreground')
            link.classList.add('border-border/50')
          }
        }
      })
    }

    cleanup() {
      window.removeEventListener('scroll', this.handleScroll)
      window.removeEventListener('resize', this.cacheSectionPositions)
    }
  }

  let desktopTOCInstance: AchievementsDesktopTOCController | null = null

  document.addEventListener('astro:page-load', () => {
    desktopTOCInstance = new AchievementsDesktopTOCController()
    desktopTOCInstance.init()
  })

  document.addEventListener('astro:before-swap', () => {
    desktopTOCInstance?.cleanup()
  })
</script>
