---
import { ScrollArea } from '@/components/ui/scroll-area'
import { Icon } from 'astro-icon/components'

interface TOCItem {
  id: string
  label: string
}

const sections: TOCItem[] = [
  { id: 'press-room', label: 'In The News' },
  { id: 'competitions', label: 'Competitions & Hackathons' },
  { id: 'credentials', label: 'Certifications & Credentials' },
  { id: 'timeline', label: 'Engineering Milestones' },
]
---

<div id="achievements-mobile-toc-container" class="w-full xl:hidden">
  <details class="group">
    <summary
      class="border-border/60 bg-background/80 flex w-full cursor-pointer list-none items-center justify-between border-b backdrop-blur-sm [&::-webkit-details-marker]:hidden"
    >
      <div class="mx-auto flex w-full max-w-3xl items-center px-4 py-3">
        <div class="relative mr-2.5 size-4 shrink-0">
          <svg class="size-4" viewBox="0 0 24 24">
            <circle
              class="text-muted/50"
              cx="12"
              cy="12"
              r="10"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            />
            <circle
              id="achievements-mobile-progress-circle"
              class="text-foreground"
              cx="12"
              cy="12"
              r="10"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-dasharray="62.83"
              stroke-dashoffset="62.83"
              transform="rotate(-90 12 12)"
            />
          </svg>
        </div>
        <span
          id="achievements-mobile-current-section"
          class="text-muted-foreground grow truncate font-mono text-xs"
        >
          Overview
        </span>
        <span class="text-muted-foreground ml-2">
          <Icon
            name="lucide:chevron-down"
            class="size-4 transition-transform duration-200 group-open:rotate-180"
          />
        </span>
      </div>
    </summary>

    <ScrollArea
      client:load
      className="bg-background/95 border-border/60 mx-auto max-w-3xl border-b"
      data-toc-header-scroll
    >
      <div class="max-h-[35vh]">
        <ul
          class="flex list-none flex-col gap-y-2 px-4 py-3 font-mono text-xs"
          id="achievements-mobile-toc-list"
        >
          {
            sections.map((section) => (
              <li>
                <a
                  href={`#${section.id}`}
                  class="achievements-mobile-toc-item text-muted-foreground hover:text-foreground block py-1 transition-colors"
                  data-section-id={section.id}
                >
                  {section.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </ScrollArea>
  </details>
</div>

<script>
  const INITIAL_LABEL = 'Overview'
  const HEADER_OFFSET = 120
  const PROGRESS_CIRCLE_RADIUS = 10
  const CIRCUMFERENCE = 2 * Math.PI * PROGRESS_CIRCLE_RADIUS

  class AchievementsMobileTOC {
    progressCircle: HTMLElement | null = null
    currentText: HTMLElement | null = null
    details: HTMLDetailsElement | null = null
    list: HTMLElement | null = null
    sections: { id: string; element: HTMLElement }[] = []

    init() {
      const container = document.getElementById(
        'achievements-mobile-toc-container',
      )
      if (!container) return

      this.progressCircle = document.getElementById(
        'achievements-mobile-progress-circle',
      )
      this.currentText = document.getElementById(
        'achievements-mobile-current-section',
      )
      this.details = container.querySelector('details')
      this.list = document.getElementById('achievements-mobile-toc-list')

      const sectionIds = ['press-room', 'competitions', 'credentials', 'timeline']
      this.sections = sectionIds
        .map((id) => ({
          id,
          element: document.getElementById(id) as HTMLElement,
        }))
        .filter((s) => s.element !== null)

      if (this.progressCircle) {
        this.progressCircle.style.strokeDasharray = CIRCUMFERENCE.toString()
        this.progressCircle.style.strokeDashoffset = CIRCUMFERENCE.toString()
      }

      // Close details when an item is clicked
      if (this.list) {
        this.list
          .querySelectorAll('.achievements-mobile-toc-item')
          .forEach((item) => {
            item.addEventListener('click', () => {
              if (this.details) {
                this.details.open = false
              }
            })
          })
      }

      this.updateProgress()
      this.updateActiveSection()

      window.addEventListener('scroll', this.handleScroll, { passive: true })
    }

    handleScroll = () => {
      this.updateProgress()
      this.updateActiveSection()
    }

    updateProgress() {
      if (!this.progressCircle) return
      const scrollable =
        document.documentElement.scrollHeight - window.innerHeight
      const progress =
        scrollable > 0 ? Math.min(Math.max(window.scrollY / scrollable, 0), 1) : 0
      this.progressCircle.style.strokeDashoffset = (
        CIRCUMFERENCE *
        (1 - progress)
      ).toString()
    }

    updateActiveSection() {
      if (this.sections.length === 0) return

      const scrollPos = window.scrollY + HEADER_OFFSET
      let currentId = ''
      let currentLabel = INITIAL_LABEL

      const labelMap: Record<string, string> = {
        'press-room': 'In The News',
        competitions: 'Competitions & Hackathons',
        credentials: 'Certifications & Credentials',
        timeline: 'Engineering Milestones',
      }

      for (let i = this.sections.length - 1; i >= 0; i--) {
        const sec = this.sections[i]
        if (sec.element.offsetTop <= scrollPos) {
          currentId = sec.id
          currentLabel = labelMap[sec.id] || INITIAL_LABEL
          break
        }
      }

      if (this.currentText) {
        this.currentText.textContent = currentLabel
      }

      if (this.list) {
        this.list
          .querySelectorAll<HTMLElement>('.achievements-mobile-toc-item')
          .forEach((item) => {
            const match = item.dataset.sectionId === currentId
            item.classList.toggle('text-foreground', match)
            item.classList.toggle('font-semibold', match)
            item.classList.toggle('text-muted-foreground', !match)
          })
      }
    }

    cleanup() {
      window.removeEventListener('scroll', this.handleScroll)
    }
  }

  let mobileTOCInstance: AchievementsMobileTOC | null = null

  document.addEventListener('astro:page-load', () => {
    mobileTOCInstance = new AchievementsMobileTOC()
    mobileTOCInstance.init()
  })

  document.addEventListener('astro:before-swap', () => {
    mobileTOCInstance?.cleanup()
  })
</script>
