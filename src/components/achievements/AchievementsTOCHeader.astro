---
import { ScrollArea } from '@/components/ui/scroll-area'
import { Icon } from 'astro-icon/components'

interface TOCItem {
  id: string
  label: string
  sub?: boolean
}

const sections: TOCItem[] = [
  { id: 'competitions', label: 'Competitions & Honors', sub: false },
  { id: 'featured-champion', label: 'Mini Inno Waste 2.0 (Juara)', sub: true },
  { id: 'timeline', label: 'Academic Foundations', sub: false },
]
---

<div id="achievements-mobile-toc-container" class="w-full xl:hidden">
  <details class="group">
    <summary
      class="border-border/60 bg-background/80 flex w-full cursor-pointer list-none items-center justify-between border-b backdrop-blur-sm [&::-webkit-details-marker]:hidden"
    >
      <div class="mx-auto flex w-full max-w-3xl items-center px-4 py-3">
        <div class="relative mr-2.5 size-4 shrink-0">
          <svg class="size-4" viewBox="0 0 24 24">
            <circle
              class="text-muted/50"
              cx="12"
              cy="12"
              r="10"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            />
            <circle
              id="achievements-mobile-progress-circle"
              class="text-foreground"
              cx="12"
              cy="12"
              r="10"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-dasharray="62.83"
              stroke-dashoffset="62.83"
              transform="rotate(-90 12 12)"
            />
          </svg>
        </div>
        <span
          id="achievements-mobile-current-section"
          class="text-muted-foreground flex-grow truncate font-mono text-xs"
        >
          {sections[0].label}
        </span>
        <Icon
          name="lucide:chevron-down"
          class="text-muted-foreground ml-2 size-4 shrink-0 transition-transform duration-200 group-open:rotate-180"
        />
      </div>
    </summary>

    <div
      class="border-border/60 bg-background/95 fixed inset-x-0 z-40 border-b backdrop-blur-md"
    >
      <ScrollArea client:load className="max-h-[60vh] overflow-y-auto" type="auto">
        <div class="mx-auto max-w-3xl px-4 py-3 font-mono">
          <div
            class="text-muted-foreground mb-2 flex items-center gap-1.5 text-xs font-semibold tracking-wider uppercase"
          >
            <Icon name="lucide:list" class="size-3.5" />
            <span>On This Page</span>
          </div>

          <nav class="flex flex-col gap-1 text-xs">
            {
              sections.map((sec) => (
                <a
                  href={`#${sec.id}`}
                  data-toc-target={sec.id}
                  class={`achievements-mobile-toc-link flex items-center justify-between py-2 transition-colors ${
                    sec.sub
                      ? 'border-border/40 text-muted-foreground/75 hover:text-foreground ml-3 border-l pl-3'
                      : 'text-muted-foreground hover:text-foreground font-medium'
                  }`}
                >
                  <span>{sec.label}</span>
                </a>
              ))
            }
          </nav>
        </div>
      </ScrollArea>
    </div>
  </details>
</div>

<script>
  const CIRCLE_RADIUS = 10
  const CIRCLE_CIRCUMFERENCE = 2 * Math.PI * CIRCLE_RADIUS

  class AchievementsMobileTOCController {
    detailsElement: HTMLDetailsElement | null = null
    currentSectionSpan: HTMLSpanElement | null = null
    progressCircle: SVGCircleElement | null = null
    links: NodeListOf<HTMLAnchorElement> | null = null
    sections: { id: string; label: string; element: HTMLElement }[] = []

    init() {
      this.detailsElement = document.querySelector(
        '#achievements-mobile-toc-container details',
      )
      this.currentSectionSpan = document.getElementById(
        'achievements-mobile-current-section',
      )
      this.progressCircle = document.getElementById(
        'achievements-mobile-progress-circle',
      ) as unknown as SVGCircleElement
      this.links = document.querySelectorAll(
        '.achievements-mobile-toc-link',
      )

      if (!this.detailsElement || !this.currentSectionSpan || !this.progressCircle) {
        return
      }

      this.cacheSections()
      this.setupEventListeners()
      this.updateProgress()
    }

    cacheSections() {
      this.sections = []
      const sectionConfigs = [
        { id: 'competitions', label: 'Competitions & Honors' },
        { id: 'featured-champion', label: 'Mini Inno Waste 2.0 (Juara)' },
        { id: 'timeline', label: 'Academic Foundations' },
      ]

      sectionConfigs.forEach((cfg) => {
        const el = document.getElementById(cfg.id)
        if (el) {
          this.sections.push({
            id: cfg.id,
            label: cfg.label,
            element: el,
          })
        }
      })
    }

    setupEventListeners() {
      window.addEventListener('scroll', this.updateProgress, { passive: true })

      this.links?.forEach((link) => {
        link.addEventListener('click', () => {
          if (this.detailsElement) {
            this.detailsElement.open = false
          }
        })
      })

      document.addEventListener('click', (e) => {
        if (
          this.detailsElement &&
          this.detailsElement.open &&
          !this.detailsElement.contains(e.target as Node)
        ) {
          this.detailsElement.open = false
        }
      })
    }

    updateProgress = () => {
      const scrollable =
        document.documentElement.scrollHeight - window.innerHeight
      const scrollY = window.scrollY

      if (this.progressCircle && scrollable > 0) {
        const progress = Math.min(Math.max(scrollY / scrollable, 0), 1)
        const offset = CIRCLE_CIRCUMFERENCE * (1 - progress)
        this.progressCircle.style.strokeDashoffset = offset.toString()
      }

      if (this.sections.length === 0 || !this.currentSectionSpan) return

      const scrollPos = window.scrollY + 140
      const isAtBottom =
        window.innerHeight + window.scrollY >=
        document.documentElement.scrollHeight - 60

      let currentSec = this.sections[0]

      if (isAtBottom) {
        currentSec = this.sections[this.sections.length - 1]
      } else {
        for (let i = this.sections.length - 1; i >= 0; i--) {
          const sectionTop =
            this.sections[i].element.getBoundingClientRect().top + window.scrollY
          if (scrollPos >= sectionTop) {
            currentSec = this.sections[i]
            break
          }
        }
      }

      this.currentSectionSpan.textContent = currentSec.label

      this.links?.forEach((link) => {
        const targetId = link.getAttribute('data-toc-target')
        if (targetId === currentSec.id) {
          link.classList.remove('text-muted-foreground', 'text-muted-foreground/75')
          link.classList.add('text-foreground', 'font-semibold')
        } else {
          link.classList.remove('text-foreground', 'font-semibold')
          link.classList.add('text-muted-foreground')
        }
      })
    }

    cleanup() {
      window.removeEventListener('scroll', this.updateProgress)
    }
  }

  let mobileTOCInstance: AchievementsMobileTOCController | null = null

  document.addEventListener('astro:page-load', () => {
    mobileTOCInstance = new AchievementsMobileTOCController()
    mobileTOCInstance.init()
  })

  document.addEventListener('astro:before-swap', () => {
    mobileTOCInstance?.cleanup()
  })
</script>
