---
import Badge from '@/components/Badge.astro'
import Link from '@/components/Link.astro'
import { Separator } from '@/components/ui/separator'
import { extractDomain, formatMonthYear } from '@/lib/utils'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'

interface Props {
  project: CollectionEntry<'projects'>
}

const { project } = Astro.props

const hasNotes = project.body && project.body.trim().length > 0
const href = hasNotes ? `/projects/${project.id}` : project.data.link || '#'
const isExternal = !hasNotes && !!project.data.link
---

<div
  class="group hover:bg-secondary/50 relative flex flex-col gap-4 border p-4 transition-colors duration-300 ease-in-out sm:flex-row"
>
  {
    project.data.image &&
      (typeof project.data.image === 'object' && 'src' in project.data.image ? (
        <div class="pointer-events-none relative z-10 max-w-3xs sm:shrink-0">
          <Image
            src={project.data.image}
            alt={project.data.name}
            width={1200}
            height={630}
            class="object-cover"
          />
        </div>
      ) : typeof project.data.image === 'string' ? (
        <div class="pointer-events-none relative z-10 max-w-3xs sm:shrink-0">
          <img
            src={project.data.image}
            alt={project.data.name}
            width="1200"
            height="630"
            loading="lazy"
            class="object-cover"
          />
        </div>
      ) : null)
  }
  <div class="flex grow flex-col justify-center">
    <h3 class="mb-1 text-lg font-medium">
      <Link
        href={href}
        class="before:absolute before:inset-0"
        external={isExternal}
      >
        {project.data.name}
      </Link>
    </h3>
    <p
      class="text-muted-foreground pointer-events-none relative z-10 mb-2 text-sm"
    >
      {project.data.description}
    </p>
    {
      project.data.startDate && (
        <div class="text-muted-foreground/70 relative z-10 mb-2 flex flex-wrap items-center gap-x-2 text-xs">
          <span class="pointer-events-none flex items-center gap-x-1.5">
            <Icon name="lucide:calendar" class="size-3" />
            <span>
              {formatMonthYear(project.data.startDate)}
              {project.data.endDate
                ? ` → ${formatMonthYear(project.data.endDate)}`
                : ' → Present'}
            </span>
          </span>
          {project.data.link && (
            <>
              <Separator
                orientation="vertical"
                className="h-4! pointer-events-none"
              />
              <Link
                href={project.data.link}
                external
                class="hover:text-foreground relative z-20 flex items-center gap-x-1 hover:underline"
              >
                <Icon name="lucide:external-link" class="size-3" />
                <span>{extractDomain(project.data.link)}</span>
              </Link>
            </>
          )}
        </div>
      )
    }
    {
      project.data.tags && (
        <div class="pointer-events-none relative z-10 flex flex-wrap gap-2">
          {project.data.tags.map((tag: string) => (
            <Badge text={tag} />
          ))}
        </div>
      )
    }
  </div>
</div>
